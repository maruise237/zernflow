# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Late API key and AI provider key are set per-workspace in Settings UI.
# For self-hosted, you can optionally set provider keys as fallbacks.

# AI Response flow node
# DeepSeek direct provider (recommended for Dokploy/Heroku self-hosting)
# DEEPSEEK_API_KEY=your-deepseek-key
# Optional AI Gateway fallback for non-DeepSeek provider/model ids
# AI_GATEWAY_API_KEY=your-gateway-key

# Cron secret (for sequence processor + job scheduler)
CRON_SECRET=your-cron-secret
# Optional for Dokploy/self-hosted internal cron runner
CRON_BASE_URL=http://localhost:3000
# DISABLE_INTERNAL_CRON=true

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
